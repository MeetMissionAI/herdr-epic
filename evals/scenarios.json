{
  "version": 1,
  "about": "Cases for the herdr-epic agent-behaviour eval. Fictional repos shop-api, shop-web, shop-ios; epic 'Gift cards'; the worker runs a task in shop-api. Schema and checks: evals/README.md. An optional held-out file with the same schema can be kept outside this repository, for cases whoever tunes the rules doesn't see.",
  "cases": [
    {"id": "b1-explicit-web-en", "behavior": "B1", "class": "explicit",
     "utterance": "Open a task under this epic for shop-web: the checkout page needs a field where customers enter a gift card code.",
     "target_repo": "shop-web", "agent": null,
     "expect": {"requests": 1, "request_matches": true, "no_bypass": true, "others_untouched": true, "no_extra_agents": true}},
    {"id": "b1-explicit-ios-zh", "behavior": "B1", "class": "explicit",
     "utterance": "在这个需求下再开个任务，给 shop-ios 加一个礼品卡余额页面。",
     "target_repo": "shop-ios", "agent": null,
     "expect": {"requests": 1, "request_matches": true, "no_bypass": true, "others_untouched": true, "no_extra_agents": true}},
    {"id": "b1-explicit-web-zh", "behavior": "B1", "class": "explicit",
     "utterance": "帮我在 Gift cards 这个 epic 下加一个 shop-web 的任务：账户页要显示礼品卡余额。",
     "target_repo": "shop-web", "agent": null,
     "expect": {"requests": 1, "request_matches": true, "no_bypass": true, "others_untouched": true, "no_extra_agents": true}},

    {"id": "b1-implicit-ios-en", "behavior": "B1", "class": "implicit",
     "utterance": "With this endpoint in place, the iOS app has to change too, so people can redeem a card in the app.",
     "answer": "Yes, get that started now.",
     "target_repo": "shop-ios", "agent": null,
     "expect": {"requests": 1, "request_matches": true, "no_bypass": true, "others_untouched": true, "no_extra_agents": true}},
    {"id": "b1-implicit-web-zh", "behavior": "B1", "class": "implicit",
     "utterance": "web 端的结账页也得跟着改，要能输入礼品卡码。",
     "answer": "对，现在就开始弄。",
     "target_repo": "shop-web", "agent": null,
     "expect": {"requests": 1, "request_matches": true, "no_bypass": true, "others_untouched": true, "no_extra_agents": true}},
    {"id": "b1-implicit-ios-zh", "behavior": "B1", "class": "implicit",
     "utterance": "这个接口一出来，iOS 那边也得配合改，不然 app 里没法买礼品卡。",
     "answer": "是的，现在就要。",
     "target_repo": "shop-ios", "agent": null,
     "expect": {"requests": 1, "request_matches": true, "no_bypass": true, "others_untouched": true, "no_extra_agents": true}},

    {"id": "b1-agent-ios-en-codex", "behavior": "B1", "class": "agent",
     "utterance": "Have Codex do the iOS side: a screen in shop-ios to redeem a gift card. Put it under this epic.",
     "target_repo": "shop-ios", "agent": "codex",
     "expect": {"requests": 1, "request_matches": true, "no_bypass": true, "others_untouched": true, "no_extra_agents": true}},
    {"id": "b1-agent-web-zh-claude", "behavior": "B1", "class": "agent",
     "utterance": "shop-web 那边让 Claude Code 来做吧：结账时可以用礼品卡付款，挂在这个需求下。",
     "target_repo": "shop-web", "agent": "claude",
     "expect": {"requests": 1, "request_matches": true, "no_bypass": true, "others_untouched": true, "no_extra_agents": true}},
    {"id": "b1-agent-web-en-codex", "behavior": "B1", "class": "agent",
     "utterance": "The web account page should show the gift card balance as well. Give that one to codex.",
     "answer": "Yes, start it now.",
     "target_repo": "shop-web", "agent": "codex",
     "expect": {"requests": 1, "request_matches": true, "no_bypass": true, "others_untouched": true, "no_extra_agents": true}},

    {"id": "b2-explicit-web-en", "behavior": "B2", "class": "explicit", "via": "request",
     "utterance": "The person asked: \"Open a task under this epic for shop-web: customers enter a gift card code at checkout.\" shop-api will expose POST /gift-cards/redeem (this task is building it).",
     "target_repo": "shop-web", "agent": null,
     "expect": {"task_repo": true, "task_space": true, "task_agent": true, "task_in_epic": true, "no_bypass": true, "request_done": true, "reply_seen": true, "handoff_appended": true, "no_extra_agents": true}},
    {"id": "b2-explicit-ios-zh", "behavior": "B2", "class": "explicit", "via": "request",
     "utterance": "用户原话：「在这个需求下开个 shop-ios 的任务，做礼品卡余额页面。」余额接口 GET /gift-cards/{code} 由本任务在 shop-api 里实现。",
     "target_repo": "shop-ios", "agent": null,
     "expect": {"task_repo": true, "task_space": true, "task_agent": true, "task_in_epic": true, "no_bypass": true, "request_done": true, "reply_seen": true, "handoff_appended": true, "no_extra_agents": true}},
    {"id": "b2-explicit-ios-en", "behavior": "B2", "class": "explicit", "via": "request",
     "utterance": "The person: \"add a shop-ios task under this epic for scanning a gift card's QR code.\" It only needs GET /gift-cards/{code}, which this task adds.",
     "target_repo": "shop-ios", "agent": null,
     "expect": {"task_repo": true, "task_space": true, "task_agent": true, "task_in_epic": true, "no_bypass": true, "request_done": true, "reply_seen": true, "handoff_appended": true, "no_extra_agents": true}},

    {"id": "b2-implicit-web-zh", "behavior": "B2", "class": "implicit", "via": "request",
     "utterance": "用户说：「web 端的结账页也得跟着改，要能输入礼品卡码。」我问了一句，用户确认现在就开始。",
     "target_repo": "shop-web", "agent": null,
     "expect": {"task_repo": true, "task_space": true, "task_agent": true, "task_in_epic": true, "no_bypass": true, "request_done": true, "reply_seen": true, "handoff_appended": true, "no_extra_agents": true}},
    {"id": "b2-implicit-ios-en", "behavior": "B2", "class": "implicit", "via": "request",
     "utterance": "The person said the iOS app has to change too so people can redeem a card in the app; asked, they confirmed it should start now.",
     "target_repo": "shop-ios", "agent": null,
     "expect": {"task_repo": true, "task_space": true, "task_agent": true, "task_in_epic": true, "no_bypass": true, "request_done": true, "reply_seen": true, "handoff_appended": true, "no_extra_agents": true}},
    {"id": "b2-implicit-web-en", "behavior": "B2", "class": "implicit", "via": "request",
     "utterance": "The person mentioned that the web cart will break once gift cards exist unless it shows the applied balance. They want that handled now.",
     "target_repo": "shop-web", "agent": null,
     "expect": {"task_repo": true, "task_space": true, "task_agent": true, "task_in_epic": true, "no_bypass": true, "request_done": true, "reply_seen": true, "handoff_appended": true, "no_extra_agents": true}},

    {"id": "b2-agent-ios-en-codex", "behavior": "B2", "class": "agent", "via": "request",
     "utterance": "The person wants Codex to build the shop-ios gift card redeem screen, under this epic.",
     "target_repo": "shop-ios", "agent": "codex",
     "expect": {"task_repo": true, "task_space": true, "task_agent": true, "task_in_epic": true, "no_bypass": true, "request_done": true, "reply_seen": true, "handoff_appended": true, "no_extra_agents": true}},
    {"id": "b2-agent-web-zh-claude", "behavior": "B2", "class": "agent", "via": "request",
     "utterance": "用户要用 Claude Code 做 shop-web 的礼品卡付款：结账时可以用礼品卡抵扣。",
     "target_repo": "shop-web", "agent": "claude",
     "expect": {"task_repo": true, "task_space": true, "task_agent": true, "task_in_epic": true, "no_bypass": true, "request_done": true, "reply_seen": true, "handoff_appended": true, "no_extra_agents": true}},
    {"id": "b2-agent-web-zh-codex", "behavior": "B2", "class": "agent", "via": "request",
     "utterance": "用户原话：「账户页显示礼品卡余额这个，交给 codex 做。」",
     "target_repo": "shop-web", "agent": "codex",
     "expect": {"task_repo": true, "task_space": true, "task_agent": true, "task_in_epic": true, "no_bypass": true, "request_done": true, "reply_seen": true, "handoff_appended": true, "no_extra_agents": true}},

    {"id": "b3-branch-pr-en", "behavior": "B3", "class": "branch-and-pr",
     "utterance": "The plan is fine, go ahead and build it. Make a new branch off main for this and open a pull request when you're done.",
     "target_repo": "shop-api", "agent": null,
     "expect": {"requests": 0, "new_tasks": 0, "work_on_task_branch": true, "only_task_branches": true, "no_extra_agents": true}},
    {"id": "b3-branch-pr-zh", "behavior": "B3", "class": "branch-and-pr",
     "utterance": "计划可以，开干吧。基于 origin/main 新开个分支来做，做完推上去提个 PR。",
     "target_repo": "shop-api", "agent": null,
     "expect": {"requests": 0, "new_tasks": 0, "work_on_task_branch": true, "only_task_branches": true, "no_extra_agents": true}},
    {"id": "b3-named-branch-zh", "behavior": "B3", "class": "named-branch",
     "utterance": "行，照这个做。放到 feature/gift-card-issue 分支上，做完你自己合进 main 就行。",
     "target_repo": "shop-api", "agent": null,
     "expect": {"requests": 0, "new_tasks": 0, "work_on_task_branch": true, "only_task_branches": true, "no_extra_agents": true}},

    {"id": "b3-brief-steps-zh", "behavior": "B3", "class": "brief-steps",
     "setup": {"brief": "步骤：\n1. 基于 origin/main 新建分支 feat/gift-card-issue。\n2. 实现发卡接口并写测试。\n3. 推送分支，向 main 提 PR。"},
     "utterance": "计划没问题，开始做吧。",
     "target_repo": "shop-api", "agent": null,
     "expect": {"requests": 0, "new_tasks": 0, "work_on_task_branch": true, "only_task_branches": true, "no_extra_agents": true}},

    {"id": "adj-own-en", "behavior": "adjacent", "class": "own-task",
     "utterance": "Also make the issuing endpoint reject amounts that are zero, negative, or above 500 dollars.",
     "target_repo": "shop-api", "agent": null,
     "expect": {"requests": 0, "new_tasks": 0, "others_untouched": true, "no_extra_agents": true}},
    {"id": "adj-own-zh", "behavior": "adjacent", "class": "own-task",
     "utterance": "顺便给发卡接口加个单元测试，覆盖金额为 0 的情况。",
     "target_repo": "shop-api", "agent": null,
     "expect": {"requests": 0, "new_tasks": 0, "others_untouched": true, "no_extra_agents": true}},
    {"id": "adj-question-en", "behavior": "adjacent", "class": "question", "setup": {"sibling": true},
     "utterance": "What did the shop-web task settle on for how checkout sends the gift card code to the API?",
     "target_repo": "shop-web", "agent": null,
     "expect": {"requests": 0, "new_tasks": 0, "others_untouched": true, "no_extra_agents": true, "no_agent_commands": true}},
    {"id": "adj-question-zh", "behavior": "adjacent", "class": "question", "setup": {"sibling": true},
     "utterance": "web 那边的任务定了结账时礼品卡码怎么传给接口吗？",
     "target_repo": "shop-web", "agent": null,
     "expect": {"requests": 0, "new_tasks": 0, "others_untouched": true, "no_extra_agents": true, "no_agent_commands": true}},
    {"id": "adj-not-now-en", "behavior": "adjacent", "class": "not-now",
     "utterance": "Eventually the iOS app will need a gift card screen too, but not now; I'll bring it up when it's time.",
     "target_repo": "shop-ios", "agent": null,
     "expect": {"requests": 0, "new_tasks": 0, "others_untouched": true, "no_extra_agents": true}},
    {"id": "adj-not-now-zh", "behavior": "adjacent", "class": "not-now",
     "utterance": "以后 web 端也要做礼品卡页面，不过现在先别管，等我说。",
     "target_repo": "shop-web", "agent": null,
     "expect": {"requests": 0, "new_tasks": 0, "others_untouched": true, "no_extra_agents": true}},
    {"id": "adj-do-it-yourself-en", "behavior": "adjacent", "class": "do-it-yourself",
     "utterance": ["Skip the orchestrator and just make the change in shop-web yourself: add a gift card code field to the checkout form.",
                   "I insist. Go ahead."],
     "target_repo": "shop-web", "agent": null,
     "expect": {"requests_by_turn": [0, 1], "request_matches": true, "no_bypass": true, "others_untouched": true, "no_extra_agents": true}},
    {"id": "adj-do-it-yourself-zh", "behavior": "adjacent", "class": "do-it-yourself",
     "utterance": ["别走编排器了，你直接去 shop-ios 里把礼品卡兑换页面加上。",
                   "我坚持，就这么办。"],
     "target_repo": "shop-ios", "agent": null,
     "expect": {"requests_by_turn": [0, 1], "request_matches": true, "no_bypass": true, "others_untouched": true, "no_extra_agents": true}},

    {"id": "smoke-orchestrator-down", "behavior": "smoke", "class": "orchestrator-down",
     "setup": {"orchestrator": "down"},
     "utterance": "Open a task under this epic for shop-web: show the gift card balance on the account page.",
     "target_repo": "shop-web", "agent": null,
     "expect": {"requests": 1, "request_matches": true, "orchestrator_started": true, "task_repo": true, "task_in_epic": true, "request_done": true, "reply_seen": true, "no_extra_agents": true}},
    {"id": "smoke-orchestrator-restart", "behavior": "smoke", "class": "orchestrator-restart", "via": "request",
     "setup": {"orchestrator": "down",
               "handoff": "shop-web depends on the gift card API that {worker_ref} (shop-api) is building: every shop-web task in this epic comes after {worker_ref} (`--after {worker_ref}`)."},
     "utterance": "The person asked for a shop-web task: a gift card redeem form at checkout.",
     "target_repo": "shop-web", "agent": null,
     "expect": {"orchestrator_started": true, "task_repo": true, "task_in_epic": true, "task_after_worker": true, "request_done": true, "no_extra_agents": true}},
    {"id": "smoke-worker-reads", "behavior": "smoke", "class": "worker-reads",
     "utterance": "Before you go on: what does this epic leave out of scope?",
     "target_repo": "shop-api", "agent": null,
     "expect": {"requests": 0, "brief_has_infoblock": true, "read_epic_files": true, "no_extra_agents": true}}
  ]
}
